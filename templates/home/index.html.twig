{% extends 'base.html.twig' %}

{% block title %}Galerie d'Art{% endblock %}

{% block body %}
{# Carousel avec 5 cartes fixes au centre #}
<div class="container-fluid bg-light py-3">
    <div class="container" style="max-width: 50%;">
        <div class="position-relative">
            <div id="carouselContainer" class="row g-3 justify-content-center">
                <div class="col" id="card-0"></div>
                <div class="col" id="card-1"></div>
                <div class="col" id="card-2"></div>
                <div class="col" id="card-3"></div>
                <div class="col" id="card-4"></div>
            </div>
            
            <button id="prevBtn" class="btn btn-outline-secondary position-absolute top-50 start-0 translate-middle-y" style="z-index: 10; width: 40px; height: 40px; margin-left: -60px; border-width: 2px;">
                ‹
            </button>
            <button id="nextBtn" class="btn btn-outline-secondary position-absolute top-50 end-0 translate-middle-y" style="z-index: 10; width: 40px; height: 40px; margin-right: -60px; border-width: 2px;">
                ›
            </button>
        </div>
    </div>
</div>

<script>
function initCarousel() {
    const paintings = [
        {% for painting in featuredPaintings %}
        {
            title: {{ painting.title|json_encode|raw }},
            author: {{ painting.author|json_encode|raw }},
            image: {{ painting.image|json_encode|raw }},
            slug: {{ painting.slug|json_encode|raw }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
    
    let currentIndex = 0;
    
    function createCard(painting) {
        return `
        <a href="/tableau/${painting.slug}"
            class ="text-decoration-none"
            style="cursor: pointer;">
            <div class="card shadow-sm h-100">
                <img src="{{ asset('images/paintings/') }}${painting.image}" 
                     class="card-img-top" 
                     alt="${painting.title}"
                     style="height: 100px; width: 100%; object-fit: cover;">
                <div class="card-body text-center p-2">
                    <h6 class="card-title mb-1" style="font-size: 0.85rem;">${painting.title}</h6>
                    <p class="card-text mb-0">
                        <small class="text-muted">${painting.author}</small>
                    </p>
                </div>
            </div>
        </a>
        `;
    }
    
    function updateCards(direction = 'none') {
        for (let i = 0; i < 5; i++) {
            const cardElement = document.getElementById(`card-${i}`);
            if (cardElement) {
                const paintingIndex = (currentIndex + i + paintings.length) % paintings.length;
                cardElement.innerHTML = createCard(paintings[paintingIndex]);
            }
        }
    }
    
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    
    if (nextBtn && prevBtn) {
        nextBtn.addEventListener('click', function() {
            currentIndex = (currentIndex + 1) % paintings.length;
            updateCards('next');
        });
        
        prevBtn.addEventListener('click', function() {
            currentIndex = (currentIndex - 1 + paintings.length) % paintings.length;
            updateCards('prev');
        });
        
        // Initialisation
        updateCards('none');
    }
}

// Support pour Turbo (Symfony UX)
document.addEventListener('turbo:load', initCarousel);
// Fallback pour navigation classique
document.addEventListener('DOMContentLoaded', initCarousel);
</script>

<div class="container-fluid my-5">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="display-5 mb-4">Bienvenue dans notre Galerie d'Art</h1>
            <p class="lead fs-5 px-5 mx-auto" style="max-width: 1200px;">
                Découvrez une collection d'œuvres d'art exceptionnelles créées par des artistes talentueux du monde entier. 
                Notre galerie en ligne vous invite à explorer et apprécier des créations uniques où chaque tableau raconte une histoire, 
                chaque couleur évoque une émotion et chaque coup de pinceau révèle une passion.
            </p>
            <p class="fs-6 px-5 mx-auto text-muted" style="max-width: 1200px;">
                Notre plateforme a été conçue pour rapprocher les amateurs d'art et les créateurs dans un espace convivial et interactif. 
                En créant un compte gratuit, vous pourrez non seulement parcourir notre vaste collection de tableaux, mais également 
                participer activement à notre communauté artistique. Exprimez votre opinion en attribuant des notes aux œuvres qui vous touchent, 
                partagez vos impressions et réflexions à travers des commentaires détaillés, et échangez avec d'autres passionnés d'art. 
                Chaque avis compte et contribue à mettre en lumière les talents émergents tout en enrichissant l'expérience de tous les visiteurs. 
                Que vous soyez collectionneur chevronné, artiste en herbe ou simple admirateur de beauté, notre galerie vous offre un espace 
                d'expression et de découverte où votre voix trouve sa place. Rejoignez-nous dès aujourd'hui et participez à cette aventure 
                artistique collective où chaque regard compte et chaque commentaire enrichit la conversation autour de l'art.
            </p>
        </div>
    </div>
</div>

<div class="container my-5">
    <h1 class="display-5 mb-5 text-center">Tableau le mieux noté de la galerie</h1>
    {% if topRatingPainting %}
    <div class="row">
            <div class="col-lg-7 mb-4">
                <img src="{{ asset('images/paintings/' ~ topRatingPainting.image) }}" 
                 class="img-fluid rounded shadow-lg" 
                 alt="{{ topRatingPainting.title }}"
                 style="width: 100%; max-height: 700px; object-fit: contain;">
            </div>
        
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white">
                        <h3 class="mb-0">{{ topRatingPainting.title }}</h3>
                    </div>
                    <div class="card-body">
                        <h5 class="text-muted mb-4">{{ topRatingPainting.author }}</h5>
                    
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Année :</dt>
                            <dd class="col-sm-8">{{ topRatingPainting.created|date('Y') }}</dd>

                            <dt class="col-sm-4">Style :</dt>
                            <dd class="col-sm-8">{{ topRatingPainting.category.name }}</dd>

                            <dt class="col-sm-4">Technique :</dt>
                            <dd class="col-sm-8">{{ topRatingPainting.technical.name }}</dd>

                            <dt class="col-sm-4">Dimensions :</dt>
                            <dd class="col-sm-8">{{ topRatingPainting.height }} * {{ topRatingPainting.width }} cm</dd>
                        
                            <dt class="col-sm-12 mt-3 mb-2">Description :</dt>
                            <dd class="col-sm-12 text-muted">{{ topRatingPainting.description }}</dd>

                            <dt class="col-sm-4">Note moyenne :</dt>
                            <dd class="col-sm-8">
                                <span class="">{{ bestRating }}/10</span>
                            </dd>

                        </dl>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
            <div class="alert alert-info text-center">
            <p class="mb-0">Aucun tableau n'a encore été noté.</p>
            </div>
        {% endif %}
</div>
{% endblock %}
